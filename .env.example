GEMINI_API_KEY=
# Pin the exact model ID once `pnpm spike:gemini` lists what your key can use
GEMINI_MODEL=gemini-3.5-flash
# Optional: a stronger model for the verifier's source re-check and read-back
GEMINI_VERIFIER_MODEL=
# USD per 1M tokens, for the cost estimate in reports. Set to your pinned model's list price.
GEMINI_PRICE_IN_PER_M=0.30
GEMINI_PRICE_OUT_PER_M=2.50

MOCK_BASE_URL=http://localhost:4000
PORTAL_USER=ap.clerk
PORTAL_PASS=portal-demo-pass
ERP_USER=ap.clerk
ERP_PASS=erp-demo-pass

# Agent
AGENT_PORT=4100
CLERK_MAX_STEPS=40
# 1 = show the browser window while the agent works
CLERK_HEADED=0

# Tracing: start Phoenix with `pnpm phoenix`, then set CLERK_TRACING=1
CLERK_TRACING=0
PHOENIX_URL=http://localhost:6006

# Optional: point Playwright at a specific Chromium build
# CHROMIUM_PATH=
