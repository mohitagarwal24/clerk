# ---- Model provider ------------------------------------------------------
# Default: NVIDIA build.nvidia.com (free key, OpenAI-compatible, ~40 requests/min).
# Any OpenAI-compatible API works the same way: Cerebras, Groq, OpenRouter, Ollama (http://localhost:11434/v1).
LLM_PROVIDER=openai
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Pick with `pnpm spike:llm --list` then `pnpm spike:llm <model> <model>`
LLM_MODEL=openai/gpt-oss-20b
# Optional: a different model for the verifier's source re-check and read-back
LLM_VERIFIER_MODEL=
# Tried in order if a model is retired (HTTP 404/410) or stops responding. Free endpoints retire models without notice.
LLM_FALLBACK_MODELS=moonshotai/kimi-k3,nvidia/nemotron-3.5-lightning-30b-a3b
# Per-request timeout before a model counts as unresponsive
LLM_TIMEOUT_MS=90000
# Requests per minute Clerk allows itself (free NVIDIA tier is ~40)
LLM_RPM=35
LLM_MAX_TOKENS=4096
# USD per 1M tokens for the cost estimate (0 on a free tier)
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# Gemini instead: set LLM_PROVIDER=gemini and fill these
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VERIFIER_MODEL=
GEMINI_PRICE_IN_PER_M=0.30
GEMINI_PRICE_OUT_PER_M=2.50

MOCK_BASE_URL=http://localhost:4000
PORTAL_USER=ap.clerk
PORTAL_PASS=portal-demo-pass
ERP_USER=ap.clerk
ERP_PASS=erp-demo-pass

# Agent
AGENT_PORT=4100
CLERK_MAX_STEPS=40
# 1 = show the browser window while the agent works
CLERK_HEADED=0

# Tracing: start Phoenix with `pnpm phoenix`, then set CLERK_TRACING=1
CLERK_TRACING=0
PHOENIX_URL=http://localhost:6006

# Optional: point Playwright at a specific Chromium build
# CHROMIUM_PATH=
